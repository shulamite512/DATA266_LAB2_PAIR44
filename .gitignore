# ===== Combined repository (Pair 44) =====
# --- Chelsi's rules ---
# never commit weights, data, generated images or secrets (C1.6, S.6)
data/
outputs/
*.safetensors
*.bin
*.ckpt
*.pt
*.png
*.jpg
*.jpeg
!docs/**/*.png
!part2/*/figures/*.png
*.zip
.env
*.token
__pycache__/
.ipynb_checkpoints/
chroma/
recordings/*.mp4
recordings/*.m4a
recordings/*.mp3
recordings/*.webm

# --- Parth's rules ---
# --- OS / editor ---
.DS_Store
.vscode/
.idea/

# --- Python / Jupyter ---
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
env/

# --- Secrets (never commit) ---
.env
.env.*
*.key
*token*
kaggle.json

# --- Course data and documents (never commit; they live outside this repo) ---
*.pdf
*.csv
*.json
!eval/*.csv
!eval/*.json
# Part 3 per-request JSON traces are submitted (D-079, D-100)
!traces/**/*.json
# Hugging Face publication approval manifest (hashes of staged files; D-117)
!publication/hf_publication_manifest.json
# ...but no images in traces/ (e.g. downloaded Wikimedia originals; inputs live in $LAB2_WORK_DIR, D-109)
traces/**/*.jpg
traces/**/*.jpeg
traces/**/*.png
# Local-only debugging files (raw model replies, D-113) - never commit
*_LOCAL_ONLY*

# --- Generated artifacts (re-created by notebooks; never commit) ---
submission.csv
chroma*/
*.sqlite3
*.faiss
*.npy
*.parquet
figure_crops/
page_renders/

# --- Model weights / caches (weights go to Hugging Face, not GitHub) ---
*.safetensors
*.bin
*.pt
*.pth
*.ckpt
hf_cache/
.cache/
checkpoints/

# --- Combined layout: evaluation evidence, traces, prompts and docs are submitted ---
!eval/**
!traces/**/*.json
!prompts/*.json
!docs/**/*.json
!docs/**/*.csv
